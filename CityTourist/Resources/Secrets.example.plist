<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Public configuration only. Never embed a service role key or Eventbrite bearer token. -->
    <key>SupabaseURL</key><string>https://YOUR-USERNAME.supabase.co</string>
    <key>SupabasePublishableKey</key><string>PASTE_PUBLIC_PUBLISHABLE_KEY</string>
    <key>EventbriteProxyURL</key><string>https://YOUR-USERNAME.supabase.co/functions/v1/eventbrite</string>
	<key>GooglePlacesAPIKey</key>
	<string>PASTE_YOUR_KEY_HERE</string>
	<!-- Optional. Claude API key for the AI Concierge feature in Simulator. -->
	<key>AnthropicAPIKey</key>
	<string>PASTE_YOUR_KEY_HERE</string>
	<!-- Optional. Events near the trip, from developer.ticketmaster.com. -->
	<key>TicketmasterAPIKey</key>
	<string>PASTE_YOUR_KEY_HERE</string>
	<!-- Optional. Short videos on place pages. Leave out to use the Google key above with YouTube Data API v3 enabled. -->
	<key>YouTubeAPIKey</key>
	<string>PASTE_YOUR_KEY_HERE</string>
	<!-- Optional. Where Settings' "Send feedback" emails go. -->
	<key>FeedbackEmail</key>
	<string>PASTE_YOUR_EMAIL_HERE</string>
	<!-- Where web/index.html is deployed. Share links are built against this. -->
	<key>ShareBaseURL</key>
	<string>https://YOUR-USERNAME.github.io/citytourist/</string>
</dict>
</plist>
